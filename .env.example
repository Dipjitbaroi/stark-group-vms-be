# ==============================================================================
# STARK GROUP VMS - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Database Connection (Single Unified Connection String)
# Format: mysql://<username>:<password>@<host>:<port>/<database>
DB_STRING=mysql://root:password@localhost:3306/vms_db

# Application Server Port
SERVER_PORT=8080

# Fleet Administrator Credentials
VMS_ADMIN_USERNAME=admin@example.com
VMS_ADMIN_PASSWORD=your_secure_password
VMS_ADMIN_FULL_NAME=Administrator
VMS_ADMIN_ROLE=FLEET_ADMIN

# Allowed CORS Origins (* for open development or comma-separated origins)
VMS_CORS_ORIGINS=*

# Initial Fleet Data Seeding (true/false)
VMS_SEED_ENABLED=false
